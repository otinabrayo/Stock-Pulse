  create  table "stockpulse"."analytics_marts"."mart_product_performance__dbt_tmp"
  
  
    as
  
  (
    with sales as (
    select *
    from "stockpulse"."analytics_staging"."stg_sales"
),

products as (
    select *
    from "stockpulse"."analytics_staging"."stg_products"
),

product_aggregates as (
    select
        sales.sku,
        products.product_name,
        products.category,
        sum(sales.quantity) as units_sold,
        count(*) as sales_lines,
        count(distinct sales.transaction_id) as transactions,
        sum(sales.quantity * sales.unit_price) as revenue,
        sum(sales.quantity * sales.unit_cost) as cost_of_goods_sold
    from sales
    left join products
        on sales.product_id = products.product_id
    group by
        sales.sku,
        products.product_name,
        products.category
)

select
    sku,
    coalesce(product_name, sku) as product_name,
    coalesce(category, 'Uncategorised') as category,
    units_sold,
    sales_lines,
    transactions,
    revenue,
    cost_of_goods_sold,
    revenue - cost_of_goods_sold as gross_profit
from product_aggregates
  );
  
[0m21:57:27.926078 [debug] [Thread-3 (]: Using postgres connection "model.stockpulse.fct_daily_sales"
[0m21:57:27.932867 [debug] [Thread-3 (]: On model.stockpulse.fct_daily_sales: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "stockpulse", "target_name": "dev", "node_id": "model.stockpulse.fct_daily_sales"} */

  
    

  create  table "stockpulse"."analytics_marts"."fct_daily_sales__dbt_tmp"
  
  
    as
  
  (
    with sales as (
    select *
    from "stockpulse"."analytics_staging"."stg_sales"

),

daily_aggregates as (

    select
        cast(sold_at as date) as sale_date,
        count(*) as sales_lines,
        count(distinct transaction_id) as transactions,
        sum(quantity) as units_sold,
        sum(quantity * unit_price) as revenue,
        sum(quantity * unit_cost) as cost_of_goods_sold
    from sales
    group by cast(sold_at as date)

)

select
    sale_date,
    sales_lines,
    transactions,
    units_sold,
    revenue,
    cost_of_goods_sold,
    revenue - cost_of_goods_sold as gross_profit,
    case
        when revenue = 0 then null
        else (revenue - cost_of_goods_sold) / revenue
    end as gross_margin_rate
from daily_aggregates
  );
  
