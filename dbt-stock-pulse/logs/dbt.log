  create  table "stockpulse"."analytics_marts"."fct_daily_sales__dbt_tmp"
  
  
    as
  
  (
    with sales as (
    select *
    from "stockpulse"."analytics_staging"."stg_unified_sales"

),

daily_aggregates as (

    select
        cast(sold_at as date) as sale_date,
        count(*) as sales_lines,
        count(distinct transaction_id) as transactions,
        sum(quantity) as units_sold,
        sum(quantity * unit_price) as revenue,
        sum(quantity * unit_cost) as cost_of_goods_sold
    from sales
    group by cast(sold_at as date)

)

select
    sale_date,
    sales_lines,
    transactions,
    units_sold,
    revenue,
    cost_of_goods_sold,
    revenue - cost_of_goods_sold as gross_profit,
    case
        when revenue = 0 then null
        else (revenue - cost_of_goods_sold) / revenue
    end as gross_margin_rate
from daily_aggregates
  );
  
[0m13:38:17.292118 [debug] [Thread-1 (]: Using postgres connection "model.stockpulse.mart_product_performance"
[0m13:38:17.293296 [debug] [Thread-4 (]: Opening a new connection, currently in state init
[0m13:38:17.295389 [debug] [Thread-1 (]: On model.stockpulse.mart_product_performance: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "stockpulse", "target_name": "dev", "node_id": "model.stockpulse.mart_product_performance"} */

  
    

  create  table "stockpulse"."analytics_marts"."mart_product_performance__dbt_tmp"
  
  
    as
  
  (
    with sales as (
    select *
    from "stockpulse"."analytics_staging"."stg_unified_sales"
),

products as (
    select *
    from "stockpulse"."analytics_staging"."stg_products"
),

product_lookup as (
    select
        sku,
        max(product_name) as product_name,
        max(category) as category
    from products
    group by sku
),

sales_with_products as (
    select
        sales.transaction_id,
        sales.sku,
        sales.quantity,
        sales.unit_price,
        sales.unit_cost,
        coalesce(
            products_by_id.product_name,
            products_by_sku.product_name,
            sales.sku
        ) as product_name,
        coalesce(
            products_by_id.category,
            products_by_sku.category,
            'Uncategorised'
        ) as category
    from sales
    left join products as products_by_id
        on sales.product_id = products_by_id.product_id
    left join product_lookup as products_by_sku
        on sales.sku = products_by_sku.sku
),

product_aggregates as (
    select
        sku,
        max(product_name) as product_name,
        max(category) as category,
        sum(quantity) as units_sold,
        count(*) as sales_lines,
        count(distinct transaction_id) as transactions,
        sum(quantity * unit_price) as revenue,
        sum(quantity * unit_cost) as cost_of_goods_sold
    from sales_with_products
    group by sku
)

select
    sku,
    product_name,
    category,
    units_sold,
    sales_lines,
    transactions,
    revenue,
    cost_of_goods_sold,
    revenue - cost_of_goods_sold as gross_profit
from product_aggregates
  );
  
