[0m21:17:42.485386 [debug] [Thread-4 (]: On model.stockpulse.mart-product-performance: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "stockpulse", "target_name": "dev", "node_id": "model.stockpulse.mart-product-performance"} */

  
    

  create  table "stockpulse"."analytics_marts"."mart-product-performance__dbt_tmp"
  
  
    as
  
  (
    with sales as (
    select *
    from "stockpulse"."analytics_staging"."stg-sales"
),

products as (
    select *
    from "stockpulse"."analytics_staging"."stg-products"
),

product_aggregates as (
    select
        sales.sku,
        products.product_name,
        products.category,
        sum(sales.quantity) as units_sold,
        count(*) as sales_lines,
        count(distinct sales.transaction_id) as transactions,
        sum(sales.quantity * sales.unit_price) as revenue,
        sum(sales.quantity * sales.unit_cost) as cost_of_goods_sold
    from sales
    left join products
        on sales.product_id = products.product_id
    group by
        sales.sku,
        products.product_name,
        products.category
)

select
    sku,
    coalesce(product_name, sku) as product_name,
    coalesce(category, 'Uncategorised') as category,
    units_sold,
    sales_lines,
    transactions,
    revenue,
    cost_of_goods_sold,
    revenue - cost_of_goods_sold as gross_profit
from product_aggregates
  );
  
