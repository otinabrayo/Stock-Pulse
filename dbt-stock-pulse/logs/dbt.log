[0m21:17:42.478203 [debug] [Thread-3 (]: On model.stockpulse.fct-daily-sales: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "stockpulse", "target_name": "dev", "node_id": "model.stockpulse.fct-daily-sales"} */

  
    

  create  table "stockpulse"."analytics_marts"."fct-daily-sales__dbt_tmp"
  
  
    as
  
  (
    with sales as (
    select *
    from "stockpulse"."analytics_staging"."stg-sales"

),

daily_aggregates as (

    select
        cast(sold_at as date) as sale_date,
        count(*) as sales_lines,
        count(distinct transaction_id) as transactions,
        sum(quantity) as units_sold,
        sum(quantity * unit_price) as revenue,
        sum(quantity * unit_cost) as cost_of_goods_sold
    from sales
    group by cast(sold_at as date)

)

select
    sale_date,
    sales_lines,
    transactions,
    units_sold,
    revenue,
    cost_of_goods_sold,
    revenue - cost_of_goods_sold as gross_profit,
    case
        when revenue = 0 then null
        else (revenue - cost_of_goods_sold) / revenue
    end as gross_margin_rate
from daily_aggregates
  );
  
[0m21:17:42.480734 [debug] [Thread-3 (]: Opening a new connection, currently in state init
